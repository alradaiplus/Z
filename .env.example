# Copy to .env for local development.

# SQLite for local development. Swap for a hosted Postgres URL in production
# (and change datasource provider to "postgresql" in prisma/schema.prisma):
#   DATABASE_URL="postgresql://USER:PASS@HOST:5432/db?schema=public"
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Generate a strong value:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
