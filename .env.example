# Copy to .env for local development. Only DATABASE_URL and AUTH_SECRET are required.

# --- Database ---------------------------------------------------------------
# SQLite for local development.
DATABASE_URL="file:./dev.db"

# Production (Supabase / Neon Postgres): use the pooled connection string for the
# app and the direct connection for migrations, and generate the client from
# prisma/schema.postgres.prisma (or switch the provider in prisma/schema.prisma).
#   DATABASE_URL="postgresql://USER:PASS@HOST:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://USER:PASS@HOST:5432/postgres"

# --- Auth -------------------------------------------------------------------
# Secret used to sign session JWTs. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Realtime collaboration (optional) --------------------------------------
# When set, the editor enables live multi-user co-editing + cursors by joining a
# Yjs room over this websocket. Leave unset for single-user mode.
# Local dev: run `npm run collab` and set NEXT_PUBLIC_COLLAB_WS_URL below.
#   NEXT_PUBLIC_COLLAB_WS_URL="ws://localhost:1234"
# Production: point at your deployed websocket service (wss://...).
# NEXT_PUBLIC_COLLAB_WS_URL=""
