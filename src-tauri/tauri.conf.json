{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Z",
  "version": "0.1.0",
  "identifier": "com.choladeck.z",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://localhost:3100",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Z",
        "width": 1280,
        "height": 832,
        "minWidth": 900,
        "minHeight": 600,
        "url": "http://localhost:3100"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
